<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Fred Catellier-Poulin</Authors>
    <Company>CAUCA INC.</Company>
    <Description>A set of extensions for EntityFrameworkCore.</Description>
    <Copyright>CAUCA 2025</Copyright>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/CAUCA-9-1-1/Cause.Core.DataLayerExtensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CAUCA-9-1-1/Cause.Core.DataLayerExtensions</RepositoryUrl>
    <PackageTags>EntityFramewokCore Cause Extensions</PackageTags>
    <PackageReleaseNotes>11.0.0 - Adds .NET 11 + EF Core 11 support. The package now targets both net10.0 (EF Core 10) and net11.0 (EF Core 11).</PackageReleaseNotes>
    <Version>11.0.0</Version>
    <AssemblyVersion>11.0.0.0</AssemblyVersion>
    <FileVersion>11.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.*" />
  </ItemGroup>

</Project>
